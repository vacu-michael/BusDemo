@using MassTransit.Futures.Contracts
@using Saga
@using Frontend.Components.Pages



<h2>Completed Workflows</h2>
<table class="table">
    <thead>
        <tr>
            <th>ApplicationId</th>
            <th>Name</th>
            <th>CurrentState</th>
            <th>LastUpdated</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var workflow in CompletedWorkflows)
        {
            <tr>
                <td>@workflow.ApplicationId</td>
                <td>@workflow.Name</td>
                <td>@workflow.CurrentState</td>
                <td>@(workflow.LastUpdated.ToString("u") ?? "-")</td>
                <td><button @onclick="@(_ => OnViewEventsClicked(workflow))">View Events</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public List<WorkflowWithName> CompletedWorkflows { get; set; } = [];
    [Inject] public NavigationManager NavigationManager { get; set; } = null!;
    public void OnViewEventsClicked(WorkflowWithName workflow)
    {
        NavigationManager.NavigateTo($"/events/{workflow.CorrelationId}");
    }
}