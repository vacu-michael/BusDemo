@page "/"
@rendermode InteractiveServer

@inject EventService events

<PageTitle>Home</PageTitle>

<label>Enter your name</label>

<input @bind="userName" @bind:after="OnUserNameChanged" />

<button @onclick="StartWorkflowAsync">Start Workflow</button>

@if (applicationId is not null)
{
    <p>Application ID: <b>@applicationId</b></p>
}

@if (isProcessing)
{
    <p>Processing...</p>
}

@if (accountNumber is not null)
{
    <p>Account Number: <b>@accountNumber</b></p>
}

@if (statusMessage is not null)
{
    <p>@statusMessage</p>
}

@code {
    [Inject] public required DemoBusinessLogic BLL { get; set; }
    [Inject] public required ILogger<Home> Logger { get; set; }
    private bool isProcessing = false;
    private string userName = string.Empty;
    private int? applicationId;
    private long? accountNumber;
    private string? statusMessage;
    private Guid? correlationId = Guid.NewGuid();

    protected override void OnInitialized()
    {
        BLL.WorkflowCompleted += async (correlationId) => await OnWorkflowCompleted(correlationId);
        BLL.WorkflowRescheduled += async (correlationId) => await OnWorkflowRescheduled(correlationId);
        BLL.WorkflowError += async (correlationId) => await OnWorkflowError(correlationId);
    }

    private async Task OnWorkflowCompleted(Guid correlationId)
    {
        if (correlationId != this.correlationId) return;

        var app = await BLL.GetApplication(applicationId ?? 0);

        if (app == null) return;

        accountNumber = app.AccountNumber;
        statusMessage = "Workflow completed successfully!";
        isProcessing = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnWorkflowRescheduled(Guid correlationId)
    {
        if (correlationId != this.correlationId) return;

        statusMessage = "Workflow rescheduled. Please wait...";
        isProcessing = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnWorkflowError(Guid correlationId)
    {
        if (correlationId != this.correlationId) return;

        statusMessage = "Workflow error occurred. Please try again later.";
        isProcessing = false;

        await InvokeAsync(StateHasChanged);
    }

    private Task OnUserNameChanged() =>
        events.LogEventAsync(
            eventType: "UserNameFieldChanged",
            correlationId: this.correlationId ?? Guid.Empty,
            data: new { UserName = userName }
            );


    private async Task StartWorkflowAsync()
    {
        correlationId = Guid.NewGuid();
        // BLL Create application method also publishes the ApplicationSubmitted event
        var newApp = await BLL.CreateApplicationAsync(userName, correlationId.Value);
        applicationId = newApp.Id;
        accountNumber = null;

        statusMessage = "Workflow started. Please wait...";
        isProcessing = true;

        await events.LogEventAsync(
            eventType: "ClickedStartWorkflowButton",
            correlationId: this.correlationId ?? Guid.Empty);
    }
}