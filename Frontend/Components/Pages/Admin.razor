@page "/admin"
@using Saga
@rendermode InteractiveServer
@implements IDisposable


<PageTitle>Admin</PageTitle>


@if (WorkflowsWithNames is null || !WorkflowsWithNames.Any())
{
    <p>No workflow states found.</p>
}
else
{
    <IncompleteTable IncompleteWorkflows="GetIncompleteWorkflows()" />
    <CompletedTable CompletedWorkflows="GetCompletedWorkflows()" />
}

@code {
    [Inject] public required AdminBusinessLogic AdminLogic { get; set; }
    [Inject] public required ILogger<Admin> Logger { get; set; }
    public List<WorkflowWithName> WorkflowsWithNames { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflowRuns();
        AdminLogic.WorkflowUpdated += OnWorkflowUpdated;
    }

    private async Task LoadWorkflowRuns()
    {
        var results = await AdminLogic.GetAllOpenAccountStatesWithNames();
        WorkflowsWithNames = results.Select(r => new WorkflowWithName
        {
            ApplicationId = r.State.ApplicationId,
            CorrelationId = r.State.CorrelationId,
            Name = r.ApplicationName ?? string.Empty,
            CurrentState = r.State.CurrentState,
            LastErrorMessage = r.State.LastErrorMessage,
            LastUpdated = r.State.LastUpdated,
            CreatedAt = r.State.CreatedAt
        }).ToList();
        StateHasChanged();
    }

    private bool WorkflowIsComplete(WorkflowWithName state) =>
        state.CurrentState is nameof(ApplicationWorkflowStateMachine.Complete);

    private void OnWorkflowUpdated()
    {
        Logger.LogInformation("Admin page detected workflow update, reloading data.");
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(500); // allow time for db to update
            await LoadWorkflowRuns();
            Logger.LogInformation("Admin page reloaded workflow data. Incomplet count: {Count}", GetIncompleteWorkflows().Count);
        });
    }

    private List<WorkflowWithName> GetIncompleteWorkflows() =>
        WorkflowsWithNames
            .Where(state => !WorkflowIsComplete(state))
            .OrderByDescending(s => s.LastUpdated)
            .ToList();

    private List<WorkflowWithName> GetCompletedWorkflows() =>
        WorkflowsWithNames
            .Where(WorkflowIsComplete)
            .OrderByDescending(s => s.LastUpdated)
            .ToList();

    public void Dispose()
    {
        AdminLogic.WorkflowUpdated -= OnWorkflowUpdated;
    }
}